---
import '@/styles/global.css'
import type { PostLayoutProps } from '@/types'
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import FootnoteScroll from '@/components/widgets/FootnoteScroll.astro'
import BaseHead from '@/components/layout/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import BackButton from '@/components/ui/BackButton.astro'
import TableOfContents from '@/components/ui/TableOfContents.astro'
import GradientMask from '@/components/ui/GradientMask.astro'
import ImageOptimizer from '@/components/ui/ImageOptimizer.astro'
import ImageViewer from '@/components/ui/ImageViewer.astro'
import GitHubCard from '@/components/ui/GitHubCard.astro'
import LinkCard from '@/components/ui/LinkCard.astro'
import NeoDBCard from '@/components/ui/NeoDBCard.astro'
import XPOST from '@/components/ui/XPOST.astro'
import CopyCode from '@/components/ui/CopyCode.astro'
import Logo from '@/components/ui/Logo.astro'
import PostFooter from '@/components/widgets/PostFooter.astro'
import NewsletterForm from '@/components/widgets/NewsletterForm.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

import { themeConfig } from '@/config'
import { formatEditionNumber } from '@/utils/draft'

const { title, pubDate, editionNumber, toc = [], contentFeatures = {} } = Astro.props as PostLayoutProps

const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || ''
const ogImage = `/open-graph/${postSlug}.png`
const shouldRenderToc = themeConfig.post.toc && toc.length > 0
const shouldRenderCopyCode = themeConfig.post.copyCode && contentFeatures.hasCodeBlock
const shouldRenderImageOptimizer = contentFeatures.hasContentImage
const shouldRenderImageViewer = themeConfig.post.imageViewer && contentFeatures.hasContentImage
const shouldRenderLinkCard = themeConfig.post.linkCard && contentFeatures.hasLinkCard
---

<BaseLayout title={`${title} · ${themeConfig.site.title}`} description={themeConfig.site.description} type="post">
  <BaseHead
    title={`${title} · ${themeConfig.site.title}`}
    description={themeConfig.site.description}
    ogImage={ogImage}
    slot="head"
  />
  <div class="post-container">
    <main>
      <div class="prose">
        <GradientMask />
        <BackButton />
        {shouldRenderToc && <TableOfContents toc={toc} />}
        <div class="title">
          <a href="/" class="post-brand">
            <Logo />
            <span class="post-brand-name">{themeConfig.site.brandName}</span>
          </a>
          {
            editionNumber ? (
              <p class="edition">Edição #{formatEditionNumber(editionNumber)}</p>
            ) : null
          }
          <h1>{title}</h1>
          <div class="author">
            {
              themeConfig.site.authorAvatar ? (
                <img
                  src={themeConfig.site.authorAvatar}
                  alt=""
                  class="author-avatar"
                  width="40"
                  height="40"
                  decoding="async"
                />
              ) : null
            }
            <p class="author-name">por {themeConfig.site.author}</p>
            <div class="date">
              <FormattedDate date={pubDate} context="post" />
            </div>
          </div>
        </div>
        <article class="content">
          <slot />
        </article>
        <section class="post-newsletter" aria-label="Newsletter">
          <NewsletterForm />
        </section>
        <PostFooter />
      </div>
    </main>
    {shouldRenderImageOptimizer && <ImageOptimizer />}
    {contentFeatures.hasFootnotes && <FootnoteScroll />}
    {shouldRenderCopyCode && <CopyCode />}
    {contentFeatures.hasGithubCard && <GitHubCard />}
    {contentFeatures.hasXPost && <XPOST />}
    {contentFeatures.hasNeoDBCard && <NeoDBCard />}
    {shouldRenderImageViewer && <ImageViewer />}
    {shouldRenderLinkCard && <LinkCard />}
    {themeConfig.general.footer && <Footer />}
  </div>
</BaseLayout>

<style>
  .post-container {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-container main {
    flex: 1;
  }
</style>
