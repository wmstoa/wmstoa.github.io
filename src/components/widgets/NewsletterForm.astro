---
const FORM_ACTION = 'https://app.loops.so/api/newsletter-form/cmp2xckuz03s00i0w091tnqr7'
---

<div class="newsletter-form-container">
  <form class="newsletter-form" action={FORM_ACTION} method="POST">
    <div class="newsletter-field">
      <p>Receba as edições no seu email.</p>
      <label class="sr-only" for="newsletter-email">Email</label>
      <input
        id="newsletter-email"
        class="newsletter-form-input"
        type="email"
        name="newsletter-form-input"
        placeholder="seu@email.com"
        required
        autocomplete="email"
      />
    </div>
    <button type="submit" class="newsletter-form-button">Inscrever-se</button>
    <button type="button" class="newsletter-loading-button" hidden>Aguarde...</button>
  </form>
  <div class="newsletter-success" hidden>
    <p class="newsletter-success-message">Obrigado! Em breve falamos com você.</p>
  </div>
  <div class="newsletter-error" hidden>
    <p class="newsletter-error-message">Algo deu errado. Tente novamente.</p>
  </div>
  <button type="button" class="newsletter-back-button" hidden>← Voltar</button>
</div>

<script is:inline>
  function submitHandler(event) {
    event.preventDefault()
    const container = event.target.closest('.newsletter-form-container')
    if (!container) return

    const form = container.querySelector('.newsletter-form')
    const newsletterField = container.querySelector('.newsletter-field')
    const formInput = container.querySelector('.newsletter-form-input')
    const success = container.querySelector('.newsletter-success')
    const errorContainer = container.querySelector('.newsletter-error')
    const errorMessage = container.querySelector('.newsletter-error-message')
    const backButton = container.querySelector('.newsletter-back-button')
    const submitButton = container.querySelector('.newsletter-form-button')
    const loadingButton = container.querySelector('.newsletter-loading-button')

    const rateLimit = () => {
      errorContainer.hidden = false
      errorMessage.textContent = 'Muitas tentativas. Tente de novo daqui a pouco.'
      submitButton.hidden = true
      if (newsletterField) newsletterField.hidden = true
      backButton.hidden = false
    }

    const time = Date.now()
    const previousTimestamp = localStorage.getItem('loops-form-timestamp')

    if (previousTimestamp && Number(previousTimestamp) + 60000 > time) {
      rateLimit()
      return
    }
    localStorage.setItem('loops-form-timestamp', String(time))

    submitButton.hidden = true
    loadingButton.hidden = false

    const formBody = 'userGroup=&mailingLists=&email=' + encodeURIComponent(formInput.value)

    fetch(event.target.action, {
      method: 'POST',
      body: formBody,
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      }
    })
      .then((res) => Promise.all([res.ok, res.json(), res]))
      .then(([ok, data, res]) => {
        if (ok) {
          success.hidden = false
          form.reset()
        } else {
          errorContainer.hidden = false
          errorMessage.textContent = data.message ? data.message : res.statusText
        }
      })
      .catch((error) => {
        if (error.message === 'Failed to fetch') {
          rateLimit()
          return
        }
        errorContainer.hidden = false
        if (error.message) errorMessage.textContent = error.message
        localStorage.setItem('loops-form-timestamp', '')
      })
      .finally(() => {
        if (newsletterField) newsletterField.hidden = true
        loadingButton.hidden = true
        backButton.hidden = false
      })
  }

  function resetFormHandler(event) {
    const container = event.target.closest('.newsletter-form-container')
    if (!container) return

    const newsletterField = container.querySelector('.newsletter-field')
    const formInput = container.querySelector('.newsletter-form-input')
    const success = container.querySelector('.newsletter-success')
    const errorContainer = container.querySelector('.newsletter-error')
    const errorMessage = container.querySelector('.newsletter-error-message')
    const backButton = container.querySelector('.newsletter-back-button')
    const submitButton = container.querySelector('.newsletter-form-button')

    success.hidden = true
    errorContainer.hidden = true
    errorMessage.textContent = 'Algo deu errado. Tente novamente.'
    backButton.hidden = true
    if (newsletterField) newsletterField.hidden = false
    submitButton.hidden = false
  }

  function initNewsletterForms() {
    const formContainers = document.querySelectorAll('.newsletter-form-container')

    for (const formContainer of formContainers) {
      if (formContainer.classList.contains('newsletter-handlers-added')) continue

      const form = formContainer.querySelector('.newsletter-form')
      const backButton = formContainer.querySelector('.newsletter-back-button')

      form?.addEventListener('submit', submitHandler)
      backButton?.addEventListener('click', resetFormHandler)
      formContainer.classList.add('newsletter-handlers-added')
    }
  }

  initNewsletterForms()
  document.addEventListener('astro:page-load', initNewsletterForms)
</script>

<style>
  .newsletter-form-container {
    margin-top: 2.5rem;
    width: 100%;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.625rem;
    width: 100%;
  }

  .newsletter-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
  }

  .newsletter-field[hidden] {
    display: none;
  }

  .newsletter-field > p {
    margin: 0;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-primary);
    letter-spacing: var(--spacing-m);
  }

  .newsletter-form-input,
  .newsletter-form-button,
  .newsletter-loading-button {
    font-family: var(--sans);
    font-size: var(--font-size-m);
    line-height: 1.75;
    letter-spacing: var(--spacing-m);
    width: 100%;
    box-sizing: border-box;
    border-radius: 6px;
  }

  .newsletter-form-input {
    margin: 0;
    padding: 0.5rem 0.75rem;
    color: var(--text-primary);
    background-color: var(--bg);
    border: 1px solid var(--border);
    box-shadow: none;
    transition: border-color 0.2s ease-out;
  }

  .newsletter-form-input::placeholder {
    color: var(--text-secondary);
  }

  .newsletter-form-input:focus-visible {
    outline: 1.5px dashed var(--text-tertiary);
    outline-offset: 2px;
    border-color: var(--text-tertiary);
  }

  .newsletter-form-button,
  .newsletter-loading-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    min-height: 2.375rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    background-color: #f486f0;
    border: none;
    cursor: pointer;
    box-shadow: none;
    transition: opacity 0.2s ease-out;
  }

  .newsletter-form-button:hover {
    opacity: 0.85;
  }

  .newsletter-loading-button {
    cursor: wait;
    opacity: 0.75;
  }

  .newsletter-loading-button[hidden],
  .newsletter-form-button[hidden],
  .newsletter-form-input[hidden] {
    display: none;
  }

  .newsletter-success,
  .newsletter-error {
    display: flex;
    align-items: flex-start;
    width: 100%;
  }

  .newsletter-success[hidden],
  .newsletter-error[hidden] {
    display: none;
  }

  .newsletter-success-message,
  .newsletter-error-message {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--font-size-m);
    line-height: 1.75;
    color: var(--text-primary);
  }

  .newsletter-error-message {
    color: #8b3a3a;
  }

  .newsletter-back-button {
    margin: 0.75rem 0 0;
    padding: 0;
    font-family: var(--serif);
    font-size: var(--font-size-s);
    font-style: italic;
    color: var(--text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  .newsletter-back-button:hover {
    color: var(--text-primary);
  }

  .newsletter-back-button[hidden] {
    display: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .newsletter-form-button:hover {
      opacity: 1;
    }
  }
</style>
