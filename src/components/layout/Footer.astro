---
import { themeConfig } from '@/config'
const today = new Date()
---

<footer>
  <div class="copyright">
    <span class="date">
      &copy;
      {today.getFullYear()}
    </span>
    {themeConfig.site.author}
  </div>
</footer>
<style>
  footer {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-light);
    line-height: 1.75;
    color: var(--text-secondary);
    opacity: 0.75;
    margin-top: 4rem;
  }

  .copyright {
    white-space: nowrap;
  }

  .copyright .date {
    opacity: 1;
  }
</style>
